{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "langchain-docs": {
      "type": "remote",
      "url": "https://docs.langchain.com/mcp",
      "enabled": true
    }
  },
  "permission": {
    "bash": "ask",
    "skill": "ask",
    "edit": "allow",
    "read": "allow",
    "list": "allow",
    "grep": "allow",
    "glob": "allow",
    "lsp": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow"
  },
  "plugin": ["oh-my-opencode-slim"],
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true
}
